{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/work/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/about",
      "destination": "/#studio",
      "permanent": true
    },
    {
      "source": "/services",
      "destination": "/#build",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/#work",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/rm-safe",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/rm-safe.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/kith-grove",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/kith-grove.html",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/nana-bread",
      "destination": "/work",
      "permanent": false
    },
    {
      "source": "/nana-bread.html",
      "destination": "/work",
      "permanent": false
    }
  ]
}
